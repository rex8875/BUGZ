generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A person, identified once by their verified Discord ID.
// Verification happens globally (one OAuth confirmation), independent
// of which server(s) they end up being a member of.
model User {
  id              String       @id @default(cuid())
  discordId       String       @unique
  discordUsername String
  verifiedAt      DateTime?
  createdAt       DateTime     @default(now())
  memberships     Membership[]
  bugReports      BugReport[]  @relation("ReportedBy")
  guestAccess     GuestAccess[]
  leaderboard     LeaderboardScore[]
  weeklyScores    WeeklyScore[]
}

// One Discord server using the system. Everything else is scoped
// under a serverId so servers never see each other's data.
model Server {
  id              String       @id @default(cuid())
  discordServerId String       @unique
  name            String
  ownerDiscordId  String
  retestChannelId String?
  testerPingRoleId String?
  // False once the bot is kicked/removed from this Discord server. Data
  // is kept (reports, roles, members) — only dashboard visibility is
  // gated on this, so nothing is lost if the bot gets re-invited later.
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  roles           Role[]
  memberships     Membership[]
  bugReports      BugReport[]
  shareLinks      ShareLink[]
  guestAccess     GuestAccess[]
  bannedMembers   BannedMember[]
  auditLog        AuditLogEntry[]
  leaderboard     LeaderboardScore[]
  weeklyScores    WeeklyScore[]
}

// Custom rank defined per-server by the owner. Not hardcoded to
// "Tester"/"Dev" — the owner names ranks and toggles permissions,
// the system just enforces whatever they set.
model Role {
  id                String       @id @default(cuid())
  serverId          String
  server            Server       @relation(fields: [serverId], references: [id])
  name              String
  rank              Int          // hierarchy position; higher = more authority, used to stop a role promoting someone to its own level or above
  canSubmitBugs     Boolean      @default(true)
  canViewDashboard  Boolean      @default(false)
  canManageBugs     Boolean      @default(false)
  canPingTesters    Boolean      @default(false)
  canArchive        Boolean      @default(false)
  canEditReports    Boolean      @default(false)
  canDeleteReports  Boolean      @default(false)
  canShareDashboard Boolean      @default(false)
  canKickMembers    Boolean      @default(false)
  canBanMembers     Boolean      @default(false)
  canManageRoles    Boolean      @default(false)
  canManageSettings Boolean      @default(false)
  memberRoles       MemberRole[]

  @@unique([serverId, name])
}

// "Is this person a member of this server at all" — the roles they
// actually hold live in MemberRole below, since (matching real Discord)
// a member can hold several roles simultaneously. Holding zero roles
// means this row gets cleaned up; a Membership existing always implies
// at least one role.
model Membership {
  id       String       @id @default(cuid())
  userId   String
  user     User         @relation(fields: [userId], references: [id])
  serverId String
  server   Server       @relation(fields: [serverId], references: [id])
  joinedAt DateTime     @default(now())
  roles    MemberRole[]

  @@unique([userId, serverId])
}

// One held role. A member can have several of these — granting/revoking
// one is independent of whatever else they hold, exactly like Discord's
// own role system: giving someone a lower role doesn't touch their
// higher one. Effective permissions are the OR of every role held;
// effective rank (used to decide what you're allowed to grant/revoke,
// and what's too senior for someone else to touch) is the highest rank
// among them.
model MemberRole {
  id           String     @id @default(cuid())
  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id])
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id])
  grantedAt    DateTime   @default(now())

  @@unique([membershipId, roleId])
}

// SQLite has no native enum type — Priority, Status, and access-level
// fields below are plain Strings instead. The application code already
// treats these as plain string literals ('LOW', 'DUPLICATE', 'DEV', etc.)
// everywhere, so this is schema-only; nothing else needed to change.

// A shareable dashboard link, scoped to one server. Lets someone who
// isn't a member of the Discord server (a contractor, an HR reviewer)
// still get into that server's dashboard at View or Dev level, without
// going through the normal Role/Membership promotion path.
model ShareLink {
  id                 String           @id @default(cuid())
  serverId           String
  server             Server           @relation(fields: [serverId], references: [id])
  accessLevel        String
  label              String?
  createdByDiscordId String
  createdAt          DateTime         @default(now())
  revokedAt          DateTime?
  guestAccess        GuestAccess[]
}

// Created the first time someone actually redeems a ShareLink. Ties
// the grant to a real verified identity so dashboard actions taken by
// a guest are still attributable, and so the owner can see exactly who
// has used each link.
model GuestAccess {
  id          String    @id @default(cuid())
  shareLinkId String
  shareLink   ShareLink @relation(fields: [shareLinkId], references: [id])
  serverId    String
  server      Server    @relation(fields: [serverId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  grantedAt   DateTime  @default(now())

  @@unique([shareLinkId, userId])
}

// A discordId blocked from holding membership in this server again
// until explicitly unbanned. Banning removes any existing Membership
// and adds this row; promoting/inviting a banned person back is
// refused until the ban is lifted.
model BannedMember {
  id                 String   @id @default(cuid())
  serverId           String
  server             Server   @relation(fields: [serverId], references: [id])
  discordId          String
  bannedByDiscordId  String
  reason             String?
  bannedAt           DateTime @default(now())

  @@unique([serverId, discordId])
}

// A record of who did what, for the governance-sensitive actions —
// ownership transfer, role changes, kicks/bans, share-link issuance.
// Deliberately doesn't log routine bug-status edits; those would be
// high-frequency noise without much accountability value, and already
// carry their own updatedAt.
model AuditLogEntry {
  id              String   @id @default(cuid())
  serverId        String
  server          Server   @relation(fields: [serverId], references: [id])
  actorDiscordId  String
  action          String
  details         String?
  createdAt       DateTime @default(now())
}

model BugReport {
  id               String     @id @default(cuid())
  serverId         String
  server           Server     @relation(fields: [serverId], references: [id])
  reporterId       String
  reporter         User       @relation("ReportedBy", fields: [reporterId], references: [id])

  title            String
  description      String
  stepsToReproduce String?
  device           String?

  evidenceFileUrl  String?
  evidenceLink     String?
  f9FileUrl        String?
  f9Link           String?
  additionalInfo   String?

  priority         String     @default("MEDIUM")
  status           String     @default("NEW")

  // set once "Ping testers" or "Post in retested" fires, so we know
  // which message/thread to keep updating
  retestMessageId  String?
  retestThreadId   String?

  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  archivedAt        DateTime?
  // True once a point has been deducted for this report being marked
  // DUPLICATE — lets the status flip back and forth without double
  // deducting or double-refunding.
  pointDeducted    Boolean    @default(false)
}

// Persistent per-server score, deliberately NOT derived by counting
// BugReport rows — archived reports get hard-deleted after 15 days,
// which would silently erase history if points were just a live count.
// Also untouched by kick/rejoin, so a tester's record survives that.
model LeaderboardScore {
  id        String   @id @default(cuid())
  serverId  String
  server    Server   @relation(fields: [serverId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  points    Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([serverId, userId])
}

// Same rationale as LeaderboardScore — persisted rather than computed
// by counting reports in a date range, since old reports do eventually
// get deleted. weekStart is normalized to the Monday of whichever week
// the report was originally created in, so a late Duplicate correction
// still lands on the right week's score, not whatever week it happens
// to be when the correction is made.
model WeeklyScore {
  id        String   @id @default(cuid())
  serverId  String
  server    Server   @relation(fields: [serverId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  weekStart DateTime
  points    Int      @default(0)

  @@unique([serverId, userId, weekStart])
}
