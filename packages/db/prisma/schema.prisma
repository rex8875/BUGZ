generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A person, identified once by their verified Discord ID.
// Verification happens globally (one OAuth confirmation), independent
// of which server(s) they end up being a member of.
model User {
  id              String       @id @default(cuid())
  discordId       String       @unique
  discordUsername String
  verifiedAt      DateTime?
  createdAt       DateTime     @default(now())
  bugReports      BugReport[]  @relation("ReportedBy")
  guestAccess     GuestAccess[]
  leaderboard     LeaderboardScore[]
  weeklyScores    WeeklyScore[]
}

// One Discord server using the system. Everything else is scoped
// under a serverId so servers never see each other's data.
model Server {
  id              String       @id @default(cuid())
  discordServerId String       @unique
  name            String
  ownerDiscordId  String
  retestChannelId String?
  testerPingRoleId String?
  // Discord guild icon, captured on join/reconciliation — used for the
  // avatar shown next to the server name on the picker page.
  iconUrl         String?
  // A validated CSS background value (hex color or a 2-stop linear
  // gradient of two hex colors) set per-server from the picker page.
  // Validated in updateServerAppearance() before it ever reaches here,
  // since this gets interpolated directly into a style attribute.
  backgroundStyle String?
  // Incremented atomically each time a bug report is created in this
  // server, and handed out as that report's bugNumber. Starts at 1.
  nextBugNumber   Int      @default(1)
  // Channel where "@user reported their Xth bug" announcements post.
  // Separate from retestChannelId (retests) — a server may want these
  // in different channels.
  announceChannelId String?

  // False once the bot is kicked/removed from this Discord server. Data
  // is kept (reports, roles, members) — only dashboard visibility is
  // gated on this, so nothing is lost if the bot gets re-invited later.
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  rolePermissions RolePermission[]
  bugReports      BugReport[]
  shareLinks      ShareLink[]
  guestAccess     GuestAccess[]
  bannedMembers   BannedMember[]
  auditLog        AuditLogEntry[]
  leaderboard     LeaderboardScore[]
  weeklyScores    WeeklyScore[]
  commandPermissions CommandPermission[]
}

// Bot-granted permissions for one REAL Discord role in this server —
// not a bot-internal role concept. There's no "membership" or "grant"
// step: whoever holds this Discord role, checked live against Discord
// on every permission check, gets these permissions. Remove the role
// from someone in Discord and their access changes on the very next
// check, automatically — matching how Dyno and Arcane both work,
// rather than requiring a separate internal role-assignment step.
//
// A person can hold several Discord roles simultaneously; if more than
// one has a row here, their effective permissions are the OR of all of
// them (getEffectivePermissions in packages/db/src/index.js) — same
// "any role grants it" logic Discord itself uses for its own
// permissions.
//
// Hierarchy/rank-safety (e.g. "can't ban someone above your rank") is
// derived from Discord's own live role position ordering rather than a
// separate stored rank number — there is deliberately no rank field
// here at all.
model RolePermission {
  id                String  @id @default(cuid())
  serverId          String
  server            Server  @relation(fields: [serverId], references: [id])
  discordRoleId     String
  canSubmitBugs     Boolean @default(true)
  canViewDashboard  Boolean @default(false)
  canManageBugs     Boolean @default(false)
  canPingTesters    Boolean @default(false)
  canArchive        Boolean @default(false)
  canEditReports    Boolean @default(false)
  canDeleteReports  Boolean @default(false)
  canShareDashboard Boolean @default(false)
  canBanMembers     Boolean @default(false)
  canManageRoles    Boolean @default(false)
  canManageSettings Boolean @default(false)

  @@unique([serverId, discordRoleId])
}

// SQLite has no native enum type — Priority, Status, and access-level
// fields below are plain Strings instead. The application code already
// treats these as plain string literals ('LOW', 'DUPLICATE', 'DEV', etc.)
// everywhere, so this is schema-only; nothing else needed to change.

// A shareable dashboard link, scoped to one server. Lets someone who
// isn't a member of the Discord server (a contractor, an HR reviewer)
// still get into that server's dashboard at View or Dev level, without
// needing to hold a real Discord role that's been granted permissions.
model ShareLink {
  id                 String           @id @default(cuid())
  serverId           String
  server             Server           @relation(fields: [serverId], references: [id])
  accessLevel        String
  label              String?
  createdByDiscordId String
  createdAt          DateTime         @default(now())
  revokedAt          DateTime?
  guestAccess        GuestAccess[]
}

// Created the first time someone actually redeems a ShareLink. Ties
// the grant to a real verified identity so dashboard actions taken by
// a guest are still attributable, and so the owner can see exactly who
// has used each link.
model GuestAccess {
  id          String    @id @default(cuid())
  shareLinkId String
  shareLink   ShareLink @relation(fields: [shareLinkId], references: [id])
  serverId    String
  server      Server    @relation(fields: [serverId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  grantedAt   DateTime  @default(now())

  @@unique([shareLinkId, userId])
}

// A discordId explicitly blocked from having ANY access to this
// server's bug tracker, regardless of what Discord roles they hold or
// what those roles are configured to allow — an absolute override,
// checked before role-based permissions in getEffectivePermissions.
model BannedMember {
  id                 String   @id @default(cuid())
  serverId           String
  server             Server   @relation(fields: [serverId], references: [id])
  discordId          String
  bannedByDiscordId  String
  reason             String?
  bannedAt           DateTime @default(now())

  @@unique([serverId, discordId])
}

// A record of who did what, for the governance-sensitive actions —
// ownership transfer, role changes, kicks/bans, share-link issuance.
// Deliberately doesn't log routine bug-status edits; those would be
// high-frequency noise without much accountability value, and already
// carry their own updatedAt.
// A per-server, per-command override letting an owner restrict a
// command to a narrower set of REAL Discord roles than its general
// RolePermission access — e.g. only @QA-Lead and @Moderator can run
// /reset-score. If a command has zero rows here, it's not overridden at
// all and falls back to the bot's existing internal permission checks,
// exactly as before this feature existed — this is additive, not a
// replacement.
model CommandPermission {
  id            String @id @default(cuid())
  serverId      String
  server        Server @relation(fields: [serverId], references: [id])
  commandName   String
  discordRoleId String

  @@unique([serverId, commandName, discordRoleId])
}

model AuditLogEntry {
  id              String   @id @default(cuid())
  serverId        String
  server          Server   @relation(fields: [serverId], references: [id])
  actorDiscordId  String
  action          String
  details         String?
  createdAt       DateTime @default(now())
}

model BugReport {
  id               String     @id @default(cuid())
  serverId         String
  server           Server     @relation(fields: [serverId], references: [id])
  reporterId       String
  reporter         User       @relation("ReportedBy", fields: [reporterId], references: [id])

  // A small, human-friendly sequential number scoped to this server
  // (server's 1st, 2nd, 3rd... bug report) — used in announcements,
  // /bug lookups, and anywhere a short reference is nicer than a cuid.
  // Assigned from Server.nextBugNumber at creation time, inside the same
  // transaction, so two reports can never collide even if submitted at
  // the same instant.
  bugNumber        Int

  title            String
  description      String
  stepsToReproduce String?
  device           String?

  evidenceFileUrl  String?
  evidenceLink     String?
  f9FileUrl        String?
  f9Link           String?
  additionalInfo   String?

  priority         String     @default("MEDIUM")
  status           String     @default("NEW")

  // set once "Ping testers" or "Post in retested" fires, so we know
  // which message/thread to keep updating
  retestMessageId  String?
  retestThreadId   String?

  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  archivedAt        DateTime?
  // True once a point has been deducted for this report being marked
  // DUPLICATE — lets the status flip back and forth without double
  // deducting or double-refunding.
  pointDeducted    Boolean    @default(false)

  @@unique([serverId, bugNumber])
}

// Persistent per-server score, deliberately NOT derived by counting
// BugReport rows — archived reports get hard-deleted after 15 days,
// which would silently erase history if points were just a live count.
// Also untouched by kick/rejoin, so a tester's record survives that.
model LeaderboardScore {
  id        String   @id @default(cuid())
  serverId  String
  server    Server   @relation(fields: [serverId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  points    Int      @default(0)
  updatedAt DateTime @updatedAt
  // Set when this person leaves (or is removed from) the Discord server;
  // hides them from the leaderboard without losing their score. Cleared
  // automatically if they rejoin, or manually by an owner/permitted
  // person resetting their score.
  hiddenAt  DateTime?

  @@unique([serverId, userId])
}

// Same rationale as LeaderboardScore — persisted rather than computed
// by counting reports in a date range, since old reports do eventually
// get deleted. weekStart is normalized to the Monday of whichever week
// the report was originally created in, so a late Duplicate correction
// still lands on the right week's score, not whatever week it happens
// to be when the correction is made.
model WeeklyScore {
  id        String   @id @default(cuid())
  serverId  String
  server    Server   @relation(fields: [serverId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  weekStart DateTime
  points    Int      @default(0)
  hiddenAt  DateTime?

  @@unique([serverId, userId, weekStart])
}
