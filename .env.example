# Database
DATABASE_URL="file:./dev.db"

# From the Discord Developer Portal, your application's page:
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Must exactly match a redirect registered in the Developer Portal's OAuth2 settings
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# Public base URL of the web app — used by the bot to build the /verify link
WEB_BASE_URL=http://localhost:3000

PORT=3000
