{
  "name": "bugtracker",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:generate": "npm run generate --workspace=@bugtracker/db",
    "db:push": "npm run push --workspace=@bugtracker/db",
    "bot:dev": "npm run dev --workspace=@bugtracker/bot",
    "bot:deploy": "npm run deploy --workspace=@bugtracker/bot",
    "web:dev": "npm run dev --workspace=@bugtracker/web"
  }
}
